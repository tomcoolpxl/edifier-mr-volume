<Project>
  <PropertyGroup>
    <!-- Windows 11 SDK projections (Bluetooth LE APIs); runs on Windows 10 2004 and later. -->
    <WindowsTfm>net10.0-windows10.0.26100.0</WindowsTfm>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- The one place the version lives. A release bumps it in a "chore(release): X.Y.Z"
         commit and tags vX.Y.Z; the release workflow checks the two match (docs/RELEASING.md). -->
    <Version>1.2.1</Version>
    <!-- Keep the git hash out of the version the app shows. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
