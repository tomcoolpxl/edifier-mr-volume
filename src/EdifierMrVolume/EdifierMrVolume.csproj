<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(WindowsTfm)</TargetFramework>
    <RootNamespace>EdifierMrVolume</RootNamespace>
    <AssemblyName>EdifierMrVolume</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>Edifier MR Volume</Product>
    <!-- The exe's File description: the name Windows shows in Task Manager and in Settings'
         list of notification-area icons. -->
    <AssemblyTitle>Edifier MR Volume</AssemblyTitle>
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU' or '$(Platform)' == 'Any CPU'">x64</Platform>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Unpackaged, with the Windows App SDK runtime copied next to the exe: no installer needed. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Needed by [LibraryImport] for the few Win32 calls (cursor position, monitor DPI). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <!-- SettingsCard / SettingsExpander, as Microsoft's app-settings guidelines recommend. -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <!-- The sound-mode switch: the Toolkit's control for "a view or setting" with 2-5 choices. -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" Version="8.2.251219" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EdifierMrVolume.Core\EdifierMrVolume.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shown in the About row of the settings view (generated by tools/make-icon.ps1). -->
    <Content Include="Assets\app-icon.svg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
