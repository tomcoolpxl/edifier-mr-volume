<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(WindowsTfm)</TargetFramework>
    <RootNamespace>EdifierMrVolume</RootNamespace>
    <AssemblyName>EdifierMrVolume</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>Edifier MR Volume</Product>
    <!-- The exe's File description: the name Windows shows in Task Manager and in Settings'
         list of notification-area icons. -->
    <AssemblyTitle>Edifier MR Volume</AssemblyTitle>
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU' or '$(Platform)' == 'Any CPU'">x64</Platform>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Unpackaged, with the Windows App SDK runtime copied next to the exe: no installer needed. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Native AOT: compiled to machine code, no .NET runtime. Measured 2026-11-16 against the JIT
         build: start 402 -> 191 ms, working set 117 -> 76 MB, install 237 -> 173 MB. Needs the MSVC
         C++ build tools. -->
    <PublishAot>true</PublishAot>
    <!-- Needed by [LibraryImport] for the few Win32 calls (cursor position, monitor DPI). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <!-- The Windows App SDK package brings every component; this app uses WinUI only. Leave out
         the rest so its files don't ship: machine learning (ONNX Runtime, DirectML), AI, Search,
         Widgets, and the framework-runtime package, which an unpackaged self-contained app
         doesn't need (Windows App SDK maintainer in microsoft/WindowsAppSDK#5969). The full
         package stays referenced because H.NotifyIcon and the Community Toolkit depend on it. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" Version="2.6.5" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" Version="2.6.5" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" Version="2.4.89" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Search" Version="2.6.5" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" Version="2.6.5" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.6.5" ExcludeAssets="all" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <!-- SettingsCard / SettingsExpander, as Microsoft's app-settings guidelines recommend. -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <!-- The sound-mode switch: the Toolkit's control for "a view or setting" with 2-5 choices. -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" Version="8.2.251219" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EdifierMrVolume.Core\EdifierMrVolume.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shown in the About row of the settings view: the simple design (assets/icon/app-icon-small.svg,
         copied by tools/make-icon.ps1). -->
    <Content Include="Assets\app-icon.svg" CopyToOutputDirectory="PreserveNewest" />  </ItemGroup>

</Project>
