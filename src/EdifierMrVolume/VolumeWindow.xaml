<Window
    x:Class="EdifierMrVolume.VolumeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    Title="Speaker volume">

    <Grid x:Name="Root" Background="Transparent" KeyDown="Root_KeyDown">
        <Grid.Resources>
            <x:Double x:Key="SettingsCardWrapThreshold">280</x:Double>
            <x:Double x:Key="SettingsCardWrapNoIconThreshold">220</x:Double>
            <!-- Settings rows are laid out like Windows 11 Settings cards: a noun label, a line
                 saying what it does, and the switch on the right. -->
            <Style x:Key="DiagLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="DiagValue" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="IsTextSelectionEnabled" Value="True" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <!-- The numbers under the room-tuning words (owner: everyday words, numbers in small print). -->
            <Style x:Key="SmallPrint" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <!-- Icon buttons: about 32 x 32 (Microsoft's targeting guidance; review 2.14). -->
            <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Padding" Value="9" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </Grid.Resources>

        <!-- Main view: model and status, settings button, messages, sound mode, mute, slider and level. -->
        <Grid
            x:Name="MainView"
            VerticalAlignment="Top"
            Padding="20,8,12,16"
            RowSpacing="4"
            PointerWheelChanged="MainView_PointerWheelChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- The status sits under the model name, so large text can't push the buttons out (review 2.10). -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        x:Name="ModelText"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Edifier MR"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="StatusText"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                </StackPanel>
                <!-- Owner's choice (2026-11-16): no confirmation, and the button stays as it is.
                     The speakers come back on only with their own power button. -->
                <Button
                    x:Name="PowerButton"
                    Grid.Column="1"
                    Padding="6"
                    Background="Transparent"
                    BorderThickness="0"
                    VerticalAlignment="Center"
                    IsEnabled="False"
                    AutomationProperties.Name="Turn off speakers"
                    ToolTipService.ToolTip="Turn off speakers"
                    Click="PowerButton_Click">
                    <FontIcon Glyph="&#xE7E8;" FontSize="14" />
                </Button>
                <Button
                    x:Name="SettingsButton"
                    Grid.Column="2"
                    Style="{StaticResource IconButton}"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Settings and diagnostics"
                    ToolTipService.ToolTip="Settings and diagnostics"
                    Click="SettingsButton_Click">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                </Button>
            </Grid>

            <!-- Once, on first start: Windows may hide new notification-area icons (review 2.8). -->
            <InfoBar
                x:Name="FirstRunBar"
                Grid.Row="1"
                Margin="0,0,8,4"
                IsOpen="False"
                IsClosable="True"
                Severity="Informational"
                Title="Your volume is in the notification area"
                Closed="FirstRunBar_Closed">
                <InfoBar.ActionButton>
                    <Button Content="Taskbar settings" Click="TaskbarSettings_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Why it isn't connected, when it isn't, with what to do about it (review 2.7). -->
            <InfoBar
                x:Name="ConnectionBar"
                Grid.Row="2"
                Margin="0,0,8,4"
                IsOpen="False"
                IsClosable="False" />

            <!-- Sound mode above the volume (owner, 2026-11-16). Segmented is the Toolkit's control
                 for "a view or setting" with 2-5 choices (review 2.9); shown once the speaker has
                 reported its mode. No visible label (owner: a "Sound" label beside it looked like a
                 fourth choice); Narrator reads "Sound mode". One grid for both rows (owner: the
                 choices start where the slider starts): the mode's light sits in the column of the
                 speaker icon, the choices span the slider and the number. -->
            <Grid Grid.Row="3" ColumnSpacing="8" Padding="0,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- The light the speaker shows for the mode: red, green or white (owner, 2026-11-16:
                     a glowing LED, design A). The speaker icon's size, centred above it; its colours
                     are set in ShowModeLight. A click picks the next mode (owner, 2026-11-16), so it
                     is a Button, as Microsoft asks for an action: Enter and Space work too. Same
                     size and look as the mute button below it. -->
                <Button
                    x:Name="ModeLedButton"
                    Margin="0,0,0,8"
                    Padding="7"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    AutomationProperties.Name="Next sound mode"
                    Click="ModeLedButton_Click">
                    <Grid x:Name="ModeLed" Width="18" Height="18">
                        <Ellipse x:Name="LedGlow" />
                        <!-- The edge shows only for the white light, which a light background would hide. -->
                        <Ellipse
                            x:Name="LedCore"
                            Width="8"
                            Height="8"
                            Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                            StrokeThickness="0" />
                    </Grid>
                </Button>
                <controls:Segmented
                    x:Name="ModeBar"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Margin="0,0,0,8"
                    HorizontalAlignment="Stretch"
                    Visibility="Collapsed"
                    AutomationProperties.Name="Sound mode"
                    SelectionChanged="ModeBar_SelectionChanged">
                    <controls:SegmentedItem
                        x:Name="ModeMonitor"
                        Content="Monitor"
                        Tag="0"
                        ToolTipService.ToolTip="Neutral, as recorded" />
                    <controls:SegmentedItem
                        x:Name="ModeMusic"
                        Content="Music"
                        Tag="1"
                        ToolTipService.ToolTip="Warmer, with more mid-bass" />
                    <controls:SegmentedItem
                        x:Name="ModeCustom"
                        Content="Custom"
                        Tag="2"
                        ToolTipService.ToolTip="Equalizer curve in Settings" />
                </controls:Segmented>

                <!-- A toggle, so Narrator says whether it is on (review 2.12). -->
                <ToggleButton
                    x:Name="MuteButton"
                    Grid.Row="1"
                    Padding="7"
                    Background="Transparent"
                    BorderThickness="0"
                    IsEnabled="False"
                    AutomationProperties.Name="Mute"
                    ToolTipService.ToolTip="Mute"
                    Click="MuteButton_Click">
                    <FontIcon x:Name="MuteIcon" Glyph="&#xE767;" FontSize="18" />
                </ToggleButton>
                <Slider
                    x:Name="VolumeSlider"
                    Grid.Row="1"
                    Grid.Column="1"
                    Minimum="0"
                    Maximum="30"
                    StepFrequency="1"
                    SmallChange="1"
                    LargeChange="3"
                    IsEnabled="False"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Speaker volume"
                    ValueChanged="VolumeSlider_ValueChanged" />
                <TextBlock
                    x:Name="VolumeText"
                    Grid.Row="1"
                    Grid.Column="2"
                    MinWidth="30"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="–"
                    TextAlignment="Right"
                    VerticalAlignment="Center" />
        </Grid>
        </Grid>

        <!-- Settings, diagnostics and About, behind the gear button. -->
        <ScrollViewer
            x:Name="SettingsView"
            Visibility="Collapsed"
            VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SettingsContent" Padding="12,8,12,16" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button
                        x:Name="BackButton"
                        Style="{StaticResource IconButton}"
                        AutomationProperties.Name="Back to volume"
                        ToolTipService.ToolTip="Back"
                        Click="BackButton_Click">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    </Button>
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Settings"
                        VerticalAlignment="Center" />
                </StackPanel>

                <!-- Laid out as Microsoft's app-settings guidelines say: SettingsCard and SettingsExpander
                     from the Windows Community Toolkit, BodyStrong section headers, About at the end.
                     https://learn.microsoft.com/windows/apps/design/app-settings/guidelines-for-app-settings -->
                <StackPanel Spacing="4">
                    <TextBlock Margin="4,4,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Panel" />
                    <controls:SettingsExpander
                        x:Name="AutoOpenExpander"
                        Header="Auto-open panel"
                        Description="Opens for a moment when you turn the knob.">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE8A7;" />
                        </controls:SettingsExpander.HeaderIcon>
                        <ToggleSwitch
                            x:Name="ShowOnKnobSwitch"
                            AutomationProperties.Name="Auto-open panel"
                            Toggled="ShowOnKnobSwitch_Toggled" />
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard x:Name="HideAfterCard" Header="Close after" ContentAlignment="Vertical">
                                <!-- One group, one Tab stop, named for Narrator (review 2.11). -->
                                <RadioButtons
                                    x:Name="HideAfterChoice"
                                    MaxColumns="4"
                                    AutomationProperties.Name="Close after"
                                    SelectionChanged="HideAfter_SelectionChanged">
                                    <RadioButton Content="1 s" MinWidth="64" AutomationProperties.Name="1 second" />
                                    <RadioButton Content="2 s" MinWidth="64" AutomationProperties.Name="2 seconds" />
                                    <RadioButton Content="3 s" MinWidth="64" AutomationProperties.Name="3 seconds" />
                                    <RadioButton Content="5 s" MinWidth="64" AutomationProperties.Name="5 seconds" />
                                </RadioButtons>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <TextBlock Margin="4,12,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Volume" />
                    <controls:SettingsExpander x:Name="LimitExpander" Header="Volume limit">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE72E;" />
                        </controls:SettingsExpander.HeaderIcon>
                        <ToggleSwitch
                            x:Name="LimitSwitch"
                            AutomationProperties.Name="Volume limit"
                            Toggled="LimitSwitch_Toggled" />
                        <controls:SettingsExpander.Items>
                            <!-- A slider over the whole volume range, so it's clear what 24 is out of
                                 (owner, 2026-11-16: "up to 24 of what?"). -->
                            <controls:SettingsCard
                                x:Name="LimitCard"
                                Header="Highest level"
                                ContentAlignment="Vertical"
                                HorizontalContentAlignment="Stretch">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider
                                        x:Name="LimitSlider"
                                        Minimum="1"
                                        Maximum="30"
                                        StepFrequency="1"
                                        SmallChange="1"
                                        LargeChange="3"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Highest level"
                                        ValueChanged="LimitSlider_ValueChanged" />
                                    <TextBlock
                                        x:Name="LimitValue"
                                        Grid.Column="1"
                                        MinWidth="56"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        TextAlignment="Right"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>
                    <controls:SettingsExpander x:Name="StartExpander" Header="Start volume">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE768;" />
                        </controls:SettingsExpander.HeaderIcon>
                        <ToggleSwitch
                            x:Name="StartSwitch"
                            AutomationProperties.Name="Start volume"
                            Toggled="StartSwitch_Toggled" />
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard
                                x:Name="StartCard"
                                Header="Level"
                                ContentAlignment="Vertical"
                                HorizontalContentAlignment="Stretch">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider
                                        x:Name="StartSlider"
                                        Minimum="0"
                                        Maximum="30"
                                        StepFrequency="1"
                                        SmallChange="1"
                                        LargeChange="3"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Start level"
                                        ValueChanged="StartSlider_ValueChanged" />
                                    <TextBlock
                                        x:Name="StartValue"
                                        Grid.Column="1"
                                        MinWidth="56"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        TextAlignment="Right"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <TextBlock Margin="4,12,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Sound" />
                    <!-- A ComboBox for 4+ choices (winui-design control map). The band sliders are
                         horizontal because this page scrolls vertically (Microsoft's slider guidance:
                         don't orient a slider along the page's panning direction). -->
                    <controls:SettingsExpander
                        x:Name="EqExpander"
                        Header="Equalizer"
                        Description="Heard in Custom mode.">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE9E9;" />
                        </controls:SettingsExpander.HeaderIcon>
                        <ComboBox
                            x:Name="PresetBox"
                            MinWidth="150"
                            IsEnabled="False"
                            AutomationProperties.Name="Equalizer preset"
                            SelectionChanged="PresetBox_SelectionChanged" />
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard
                                x:Name="EqBandsCard"
                                Header="Bands"
                                ContentAlignment="Vertical"
                                HorizontalContentAlignment="Stretch"
                                IsEnabled="False">
                                <Grid x:Name="EqBandsGrid" ColumnSpacing="8" HorizontalAlignment="Stretch">
                                    <!-- Lightweight styling: no accent fill from the left end, which
                                         made a cut look like a boost; the thumb and the ticks show
                                         the step (review 2.16). -->
                                    <Grid.Resources>
                                        <ResourceDictionary>
                                            <ResourceDictionary.ThemeDictionaries>
                                                <ResourceDictionary x:Key="Light">
                                                    <StaticResource x:Key="SliderTrackValueFill" ResourceKey="SliderTrackFill" />
                                                    <StaticResource x:Key="SliderTrackValueFillPointerOver" ResourceKey="SliderTrackFillPointerOver" />
                                                    <StaticResource x:Key="SliderTrackValueFillPressed" ResourceKey="SliderTrackFillPressed" />
                                                    <StaticResource x:Key="SliderTrackValueFillDisabled" ResourceKey="SliderTrackFillDisabled" />
                                                </ResourceDictionary>
                                                <ResourceDictionary x:Key="Dark">
                                                    <StaticResource x:Key="SliderTrackValueFill" ResourceKey="SliderTrackFill" />
                                                    <StaticResource x:Key="SliderTrackValueFillPointerOver" ResourceKey="SliderTrackFillPointerOver" />
                                                    <StaticResource x:Key="SliderTrackValueFillPressed" ResourceKey="SliderTrackFillPressed" />
                                                    <StaticResource x:Key="SliderTrackValueFillDisabled" ResourceKey="SliderTrackFillDisabled" />
                                                </ResourceDictionary>
                                                <ResourceDictionary x:Key="HighContrast">
                                                    <StaticResource x:Key="SliderTrackValueFill" ResourceKey="SliderTrackFill" />
                                                    <StaticResource x:Key="SliderTrackValueFillPointerOver" ResourceKey="SliderTrackFillPointerOver" />
                                                    <StaticResource x:Key="SliderTrackValueFillPressed" ResourceKey="SliderTrackFillPressed" />
                                                    <StaticResource x:Key="SliderTrackValueFillDisabled" ResourceKey="SliderTrackFillDisabled" />
                                                </ResourceDictionary>
                                            </ResourceDictionary.ThemeDictionaries>
                                        </ResourceDictionary>
                                    </Grid.Resources>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" MinWidth="24" />
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <!-- Room tuning (ConneX's "Acoustic Tuning") in everyday words, with the numbers
                         in small print (owner, 2026-11-16). -->
                    <controls:SettingsExpander
                        x:Name="RoomExpander"
                        Header="Room"
                        Description="Bass for where the speakers stand.">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE80F;" />
                        </controls:SettingsExpander.HeaderIcon>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard
                                x:Name="WallCard"
                                Header="Where the speakers stand"
                                ContentAlignment="Vertical"
                                HorizontalContentAlignment="Stretch"
                                IsEnabled="False">
                                <StackPanel HorizontalAlignment="Stretch" Spacing="2">
                                    <Slider
                                        x:Name="WallSlider"
                                        Minimum="0"
                                        Maximum="4"
                                        StepFrequency="1"
                                        SmallChange="1"
                                        LargeChange="1"
                                        TickFrequency="1"
                                        TickPlacement="Inline"
                                        SnapsTo="StepValues"
                                        IsThumbToolTipEnabled="False"
                                        AutomationProperties.Name="Where the speakers stand, from the middle of the room to a corner"
                                        ValueChanged="WallSlider_ValueChanged" />
                                    <Grid>
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Middle of the room" />
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="In a corner" HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock x:Name="WallNumbers" Style="{StaticResource SmallPrint}" />
                                </StackPanel>
                            </controls:SettingsCard>
                            <controls:SettingsCard
                                x:Name="BassCard"
                                Header="Bass"
                                IsEnabled="False">
                                <ComboBox
                                    x:Name="BassBox"
                                    MinWidth="140"
                                    PlaceholderText="Set in the Edifier app"
                                    AutomationProperties.Name="Bass"
                                    SelectionChanged="BassBox_SelectionChanged" />
                            </controls:SettingsCard>
                            <controls:SettingsCard
                                x:Name="DeskCard"
                                Header="On a desk"
                                IsEnabled="False">
                                <ToggleSwitch
                                    x:Name="DeskSwitch"
                                    AutomationProperties.Name="On a desk"
                                    Toggled="DeskSwitch_Toggled" />
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <TextBlock Margin="4,12,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Power" />
                    <controls:SettingsCard
                        Header="Turn off when the PC sleeps"
                        Description="Turn them back on with their power button.">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7E8;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                            x:Name="SleepOffSwitch"
                            AutomationProperties.Name="Turn off when the PC sleeps"
                            Toggled="SleepOffSwitch_Toggled" />
                    </controls:SettingsCard>
                    <!-- The speaker's own setting (0xB1/0xB2), shown as the speaker reports it; the knob
                         (volume 0, double-press) changes the same setting. -->
                    <controls:SettingsCard
                        x:Name="PowerSavingCard"
                        Header="Power saving"
                        IsEnabled="False">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE708;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                            x:Name="PowerSavingSwitch"
                            AutomationProperties.Name="Power saving"
                            Toggled="PowerSavingSwitch_Toggled" />
                    </controls:SettingsCard>

                    <TextBlock Margin="4,12,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Connection" />
                    <!-- Also in the notification-area menu; here for keyboard and Narrator users (review 2.1). -->
                    <controls:SettingsCard
                        Header="Connect to speaker"
                        Description="Turn off to let the ConneX app connect.">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE702;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                            x:Name="ConnectSwitch"
                            AutomationProperties.Name="Connect to speaker"
                            Toggled="ConnectSwitch_Toggled" />
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        Header="Start with Windows">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE770;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                            x:Name="AutostartSwitch"
                            AutomationProperties.Name="Start with Windows"
                            Toggled="AutostartSwitch_Toggled" />
                    </controls:SettingsCard>
                    <controls:SettingsExpander x:Name="DiagExpander" Header="Diagnostics">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE9D9;" />
                        </controls:SettingsExpander.HeaderIcon>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard ContentAlignment="Left">
                                <Grid ColumnSpacing="12" RowSpacing="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Style="{StaticResource DiagLabel}" Text="Status" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DiagStatus" Style="{StaticResource DiagValue}" />
                                    <TextBlock Grid.Row="1" Style="{StaticResource DiagLabel}" Text="Speaker" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DiagSpeaker" Style="{StaticResource DiagValue}" />
                                    <TextBlock Grid.Row="2" Style="{StaticResource DiagLabel}" Text="Firmware" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DiagFirmware" Style="{StaticResource DiagValue}" />
                                    <TextBlock Grid.Row="3" Style="{StaticResource DiagLabel}" Text="Bluetooth address" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DiagAddress" Style="{StaticResource DiagValue}" />
                                    <TextBlock Grid.Row="4" Style="{StaticResource DiagLabel}" Text="Reconnects" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="DiagReconnects" Style="{StaticResource DiagValue}" />
                                    <TextBlock Grid.Row="5" Style="{StaticResource DiagLabel}" Text="Last error" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="DiagError" Style="{StaticResource DiagValue}" />
                                </Grid>
                            </controls:SettingsCard>
                            <controls:SettingsCard ContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="ReconnectButton" Content="Reconnect" Click="ReconnectButton_Click" />
                                    <Button x:Name="OpenLogButton" Content="Open log" Click="OpenLogButton_Click" />
                                </StackPanel>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <!-- About: the only place the app icon appears inside the app (set in code). -->
                    <TextBlock Margin="4,12,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" Text="About" />
                    <controls:SettingsExpander x:Name="AboutExpander" Header="Edifier MR Volume">
                        <!-- The app icon larger than the Toolkit's 20 px for setting icons (owner,
                             2026-11-16: "can you make the edifier icon larger?"). -->
                        <controls:SettingsExpander.Resources>
                            <x:Double x:Key="SettingsCardHeaderIconMaxSize">32</x:Double>
                        </controls:SettingsExpander.Resources>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard
                                Header="GitHub repository"
                                IsClickEnabled="True"
                                Click="GitHubLink_Click">
                                <controls:SettingsCard.ActionIcon>
                                    <FontIcon Glyph="&#xE8A7;" />
                                </controls:SettingsCard.ActionIcon>
                            </controls:SettingsCard>
                            <controls:SettingsCard
                                Header="Report a problem"
                                IsClickEnabled="True"
                                Click="ReportLink_Click">
                                <controls:SettingsCard.ActionIcon>
                                    <FontIcon Glyph="&#xE8A7;" />
                                </controls:SettingsCard.ActionIcon>
                            </controls:SettingsCard>
                            <controls:SettingsCard
                                Header="Unofficial"
                                Description="Not affiliated with Edifier. MIT License." />
                            <!-- Also in the notification-area menu; here for keyboard users (review 2.1). -->
                            <controls:SettingsCard Header="Exit">
                                <Button x:Name="ExitButton" Content="Exit" Click="ExitButton_Click" />
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
